generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense

  @@map("account_type")
}

enum BalanceMode {
  locked
  serializable
  derived
  sharded

  @@map("balance_mode")
}

model Account {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique
  type        AccountType
  currency    String           @db.Char(3)
  balanceMode BalanceMode      @map("balance_mode")
  shards      Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  entries     Entry[]
  balances    Balance[]
  snapshot    BalanceSnapshot?
  merchant    Merchant?

  @@map("accounts")
}

model Journal {
  id          BigInt              @id @default(autoincrement())
  externalRef String              @unique @map("external_ref")
  reversesId  BigInt?             @unique @map("reverses_id")
  createdAt   DateTime            @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  createdXid  Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("created_xid")
  reverses    Journal?            @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy  Journal?            @relation("Reversal")
  entries     Entry[]
  capture     Payment?            @relation("CaptureJournal")
  refund      Refund?             @relation("RefundJournal")
  payout      Payout?             @relation("PayoutJournal")
  payoutUndo  Payout?             @relation("PayoutReversalJournal")

  @@map("journals")
}

model Entry {
  id         BigInt              @id @default(autoincrement())
  journalId  BigInt              @map("journal_id")
  accountId  BigInt              @map("account_id")
  amount     BigInt
  createdXid Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("created_xid")
  currency   String              @default(dbgenerated()) @db.Char(3)
  journal    Journal             @relation(fields: [journalId], references: [id])
  account    Account             @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId, createdXid])
  @@map("entries")
}

model Balance {
  accountId BigInt  @map("account_id")
  shard     Int     @default(0)
  amount    BigInt  @default(0)
  version   BigInt  @default(0)
  account   Account @relation(fields: [accountId], references: [id])

  @@id([accountId, shard])
  @@map("balances")
}

model BalanceSnapshot {
  accountId BigInt              @id @map("account_id")
  amount    BigInt
  horizon   Unsupported("xid8")
  takenAt   DateTime            @default(now()) @map("taken_at") @db.Timestamptz(6)
  account   Account             @relation(fields: [accountId], references: [id])

  @@map("balance_snapshots")
}

enum ClientScope {
  client
  admin

  @@map("client_scope")
}

enum CaptureMode {
  auto
  manual

  @@map("capture_mode")
}

enum PaymentStatus {
  created
  authorized
  captured
  refunded
  canceled
  failed

  @@map("payment_status")
}

enum AttemptKind {
  authorize
  capture
  cancel
  refund
  payout

  @@map("attempt_kind")
}

enum AttemptStatus {
  pending
  succeeded
  declined

  @@map("attempt_status")
}

enum RefundStatus {
  pending
  succeeded
  failed

  @@map("refund_status")
}

enum PayoutStatus {
  pending
  succeeded
  failed

  @@map("payout_status")
}

enum IdempotencyState {
  started
  finished

  @@map("idempotency_state")
}

model ApiClient {
  id        BigInt           @id @default(autoincrement())
  name      String
  keyHash   Bytes            @unique @map("key_hash")
  scope     ClientScope
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(6)
  payments  Payment[]
  keys      IdempotencyKey[]

  @@map("api_clients")
}

model Merchant {
  id        BigInt    @id @default(autoincrement())
  code      String    @unique
  name      String
  currency  String    @db.Char(3)
  accountId BigInt    @unique @map("account_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account   @relation(fields: [accountId], references: [id])
  payments  Payment[]
  payouts   Payout[]

  @@map("merchants")
}

model Payment {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId         BigInt        @map("client_id")
  merchantId       BigInt        @map("merchant_id")
  amount           BigInt
  currency         String        @db.Char(3)
  captureMode      CaptureMode   @map("capture_mode")
  status           PaymentStatus @default(created)
  token            String
  pspChargeId      String?       @unique @map("psp_charge_id")
  capturedAmount   BigInt        @default(0) @map("captured_amount")
  refundedAmount   BigInt        @default(0) @map("refunded_amount")
  fee              BigInt        @default(0)
  failureReason    String?       @map("failure_reason")
  captureJournalId BigInt?       @unique @map("capture_journal_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  client           ApiClient     @relation(fields: [clientId], references: [id])
  merchant         Merchant      @relation(fields: [merchantId], references: [id])
  captureJournal   Journal?      @relation("CaptureJournal", fields: [captureJournalId], references: [id])
  attempts         Attempt[]
  refunds          Refund[]

  @@index([merchantId, createdAt])
  @@map("payments")
}

model Refund {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId     String       @map("payment_id") @db.Uuid
  amount        BigInt
  status        RefundStatus @default(pending)
  feeRefund     BigInt       @default(0) @map("fee_refund")
  failureReason String?      @map("failure_reason")
  journalId     BigInt?      @unique @map("journal_id")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt    DateTime?    @map("resolved_at") @db.Timestamptz(6)
  payment       Payment      @relation(fields: [paymentId], references: [id])
  journal       Journal?     @relation("RefundJournal", fields: [journalId], references: [id])
  attempts      Attempt[]

  @@index([paymentId])
  @@map("refunds")
}

model Payout {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId        BigInt       @map("merchant_id")
  amount            BigInt
  currency          String       @db.Char(3)
  status            PayoutStatus @default(pending)
  failureReason     String?      @map("failure_reason")
  journalId         BigInt?      @unique @map("journal_id")
  reversalJournalId BigInt?      @unique @map("reversal_journal_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz(6)
  merchant          Merchant     @relation(fields: [merchantId], references: [id])
  journal           Journal?     @relation("PayoutJournal", fields: [journalId], references: [id])
  reversalJournal   Journal?     @relation("PayoutReversalJournal", fields: [reversalJournalId], references: [id])
  attempts          Attempt[]

  @@index([merchantId, createdAt])
  @@map("payouts")
}

model Attempt {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind           AttemptKind
  status         AttemptStatus @default(pending)
  paymentId      String?       @map("payment_id") @db.Uuid
  refundId       String?       @map("refund_id") @db.Uuid
  payoutId       String?       @map("payout_id") @db.Uuid
  amount         BigInt
  currency       String        @db.Char(3)
  pspOperationId String?       @unique @map("psp_operation_id")
  declineReason  String?       @map("decline_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  refund         Refund?       @relation(fields: [refundId], references: [id])
  payout         Payout?       @relation(fields: [payoutId], references: [id])
  anomalies      Anomaly[]

  @@index([paymentId])
  @@index([refundId])
  @@index([payoutId])
  @@map("attempts")
}

model IdempotencyKey {
  clientId       BigInt           @map("client_id")
  key            String
  method         String
  path           String
  requestHash    Bytes            @map("request_hash")
  state          IdempotencyState @default(started)
  recoveryPoint  String           @default("started") @map("recovery_point")
  paymentId      String?          @map("payment_id") @db.Uuid
  refundId       String?          @map("refund_id") @db.Uuid
  payoutId       String?          @map("payout_id") @db.Uuid
  lockedUntil    DateTime?        @map("locked_until") @db.Timestamptz(6)
  leaseId        String?          @map("lease_id") @db.Uuid
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  client         ApiClient        @relation(fields: [clientId], references: [id])

  @@id([clientId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Anomaly {
  id        BigInt   @id @default(autoincrement())
  attemptId String?  @map("attempt_id") @db.Uuid
  kind      String
  details   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  attempt   Attempt? @relation(fields: [attemptId], references: [id])

  @@unique([attemptId, kind])
  @@map("anomalies")
}

model WebhookEvent {
  id         String   @id
  type       String
  attemptId  String?  @map("attempt_id") @db.Uuid
  outcome    String
  payload    Json
  checks     Int      @default(1)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  checkedAt  DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@index([outcome, receivedAt])
  @@map("webhook_events")
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @default(dbgenerated("uuidv7()")) @map("event_id") @db.Uuid
  topic       String
  key         String
  lane        Int       @db.SmallInt
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox")
}

model InboxEntry {
  consumer   String
  eventId    String   @map("event_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([receivedAt])
  @@map("inbox")
}

model ReceiptCounter {
  merchant   String @id
  lastNumber Int    @map("last_number")

  @@map("receipt_counters")
}

model Receipt {
  id         BigInt   @id @default(autoincrement())
  merchant   String
  number     Int
  paymentId  String   @map("payment_id") @db.Uuid
  amount     BigInt
  fee        BigInt
  currency   String   @db.Char(3)
  capturedAt DateTime @map("captured_at") @db.Timestamptz(6)
  eventId    String   @map("event_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([merchant, number])
  @@index([paymentId])
  @@map("receipts")
}

model Statement {
  accountId BigInt   @map("account_id")
  day       DateTime @db.Date
  debits    BigInt
  credits   BigInt
  entries   Int

  @@id([accountId, day])
  @@map("statements")
}

model SettlementFile {
  id         String           @id
  day        BigInt
  currency   String           @db.Char(3)
  lines      Int
  gross      BigInt
  fee        BigInt
  net        BigInt
  journalId  BigInt?          @map("journal_id")
  receivedAt DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)
  rows       SettlementLine[]

  @@unique([day, currency])
  @@map("settlement_files")
}

model SettlementLine {
  fileId     String         @map("file_id")
  line       Int
  operation  String
  reference  String
  kind       String
  gross      BigInt
  fee        BigInt
  net        BigInt
  operatedAt DateTime       @map("operated_at") @db.Timestamptz(6)
  file       SettlementFile @relation(fields: [fileId], references: [id])

  @@id([fileId, line])
  @@index([reference])
  @@map("settlement_lines")
}

model ReconBreak {
  id         BigInt   @id @default(autoincrement())
  currency   String   @db.Char(3)
  day        BigInt
  class      String
  fileId     String?  @map("file_id")
  line       Int?
  journalRef String?  @map("journal_ref")
  attemptId  String?  @map("attempt_id") @db.Uuid
  detail     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([currency, day])
  @@map("recon_breaks")
}

model AuditQueue {
  journalId BigInt   @id @map("journal_id")
  queuedAt  DateTime @default(now()) @map("queued_at") @db.Timestamptz(6)

  @@map("audit_queue")
}

model AuditLeaf {
  seq         BigInt   @id
  journalId   BigInt   @unique @map("journal_id")
  leaf        Bytes
  chain       Bytes
  sequencedAt DateTime @default(now()) @map("sequenced_at") @db.Timestamptz(6)

  @@map("audit_log")
}

model AuditNode {
  level Int    @db.SmallInt
  idx   BigInt
  hash  Bytes

  @@id([level, idx])
  @@map("audit_nodes")
}

model AuditCheckpoint {
  size       BigInt   @id
  root       Bytes
  signature  Bytes
  witnessKey String   @map("witness_key")
  signedAt   DateTime @map("signed_at") @db.Timestamptz(6)
  storedAt   DateTime @default(now()) @map("stored_at") @db.Timestamptz(6)

  @@map("audit_checkpoints")
}

model DemoLimit {
  name   String   @id
  lastAt DateTime @map("last_at") @db.Timestamptz(6)

  @@map("demo_limits")
}
