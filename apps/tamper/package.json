{
  "name": "@carwash/tamper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --conditions=source src/main.ts",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@carwash/audit-pg": "workspace:*",
    "@carwash/pg": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@carwash/ledger": "workspace:*",
    "@carwash/testkit": "workspace:*",
    "@carwash/witness": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
